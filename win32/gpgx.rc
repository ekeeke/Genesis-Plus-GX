                  BS_AUTOCHECKBOX | WS_TABSTOP, 10, 8, 120, 10

  CONTROL         "", IDC_CHEATS_LIST, "SysListView32",
                  LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
                  WS_BORDER | WS_TABSTOP, 10, 22, 430, 130

  LTEXT           "Name:", IDC_STATIC, 10, 164, 22, 9
  EDITTEXT        IDC_CHEATS_DESC, 36, 162, 180, 14, ES_AUTOHSCROLL
  LTEXT           "Code:", IDC_STATIC, 226, 164, 20, 9
  EDITTEXT        IDC_CHEATS_CODE, 250, 162, 190, 14, ES_AUTOHSCROLL | ES_UPPERCASE

  DEFPUSHBUTTON   "Add Code", IDC_CHEATS_ADD, 10, 182, 60, 16
  PUSHBUTTON      "Save", IDC_CHEATS_SAVE, 76, 182, 60, 16
  PUSHBUTTON      "Remove", IDC_CHEATS_REMOVE, 142, 182, 60, 16
  PUSHBUTTON      "Remove All", IDC_CHEATS_CLEAR, 208, 182, 60, 16
  PUSHBUTTON      "Load Cheat...", IDC_CHEATS_LOADCHT, 274, 182, 72, 16

  LTEXT           "", IDC_CHEATS_HINT, 10, 204, 430, 9
  PUSHBUTTON      "Close", IDOK, 390, 216, 50, 16
END

